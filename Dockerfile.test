# syntax=docker/dockerfile:1
FROM alpine:3.22 AS deployment
RUN apk add --no-cache bash busybox-extras
WORKDIR /workspace
COPY . .
CMD ["bash", "tests/test_openrc_deployment.sh"]

FROM alpine:3.22 AS config-tests

ARG XRAY_VERSION=latest
ARG XRAY_ASSET_SHA256=""

RUN apk add --no-cache bash ca-certificates coreutils curl diffutils flock iproute2 jq openrc openssl shellcheck unzip

WORKDIR /workspace
COPY . .
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN source lib/00-bootstrap.sh \
    && check_os && detect_arch \
    && download_xray_core "${XRAY_VERSION}" stable /tmp/xray-download \
    && { [[ -z "${XRAY_ASSET_SHA256}" ]] || verify_xray_asset_digest "/tmp/xray-download/${XRAY_ASSET}" "sha256:${XRAY_ASSET_SHA256}"; } \
    && install -m 0755 "$XRAY_EXTRACTED_BINARY" /usr/local/bin/xray \
    && rm -rf /tmp/xray-download

ENV XRAY_BIN=/usr/local/bin/xray
CMD ["bash", "tests/run_all.sh"]
